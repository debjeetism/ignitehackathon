# OpenAI / Custom LLM Provider
OPENAI_API_KEY=your-openai-compatible-api-key
OPENAI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Optional: Custom base URL for OpenAI-compatible APIs
# Examples: OpenRouter, Together AI, Groq, Ollama, etc.
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_BASE_URL=https://api.together.xyz/v1
# OPENAI_BASE_URL=http://localhost:11434/v1  # Ollama

# Tavily
TAVILY_API_KEY=tvly-your-tavily-key-here

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j
# Only enable for local environments with intercepted/self-signed TLS certificates.
NEO4J_TRUST_ALL_CERTIFICATES=false

# App
DEBUG=true
#for dumping logs
IGNITE_DATA_DIR=/path/to/log/dir
